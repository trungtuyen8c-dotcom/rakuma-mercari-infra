# Copy to .env and adjust. Never commit .env.
APP_ENV=development
# Public URL of the site. Google OAuth redirect URI = $APP_URL/api/v1/auth/google/callback
APP_URL=http://localhost:8088
WEB_PORT=8088

DB_USER=rakuma
DB_PASSWORD=change-me
DB_NAME=rakuma
DB_PORT=55432

# The only Google account allowed to sign in
RAKUMA_OWNER_EMAIL=chushop.rakuma@gmail.com

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Empty = no Google button. Owner password: docker compose exec backend set-password -generate
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
